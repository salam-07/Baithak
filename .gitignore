DESIGN.md
PRODUCT.md

.impeccable

# Secrets. Each service keeps its own .gitignore, but the rule goes here too,
# because a pattern in one directory does not cover another and `.env.production`
# is a file anyone might add without thinking about it. Values never belong in
# the repository — backend/.env.example documents the shape of the file and
# carries none. The negation below is what keeps that example file committable.
.env
.env.*
!.env.example
.keyword-qa
.claude
.feed-qa

# Dependencies, build output, and local logs
node_modules/
dist/
dist-ssr/
logs/
*.log
*.local

# Editor and operating system files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local folklore seed preservation fingerprints and audit reports
.folklore-qa/
backend/src/services/reading-performance.test.js
backend/src/utils/cache.test.js
backend/src/utils/cache.test.js
backend/src/models/onboarding.test.js
frontend/tests/onboarding-navigation.test.mjs
