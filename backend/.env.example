# ---------------------------------------------------------------------------
# Baithak backend environment
#
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed:
# the Mongo URI and the JWT secret are the only two values here that matter to
# an attacker, and both are enough to read every account and forge any session.
# ---------------------------------------------------------------------------

# Required -------------------------------------------------------------------

# MongoDB connection string, e.g. mongodb+srv://user:pass@cluster/baithak
MONGODB_URI=

# Signing key for access and refresh tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional -------------------------------------------------------------------
# Everything below has a working default in src/config/env.js. Set these only
# to override. The service boots without any of them.

# HTTP port (default 5000)
PORT=5000

# development | production | test (default development)
NODE_ENV=development

# Comma-separated browser origins allowed to call the API. Unset in development
# reflects any origin; in production an unset value denies cross-origin calls.
# e.g. http://localhost:5173,https://baithak.example
CORS_ORIGINS=

# Trust X-Forwarded-For for the client address (default: on in production, off
# otherwise). Set this only when a load balancer or PaaS router sits in front of
# the service. Trusting it while directly internet-facing lets any client forge
# its own address and bypass the rate limiter completely.
TRUST_PROXY=false

# Access token lifetime (default 15m). Accepts zeit/ms shorthand.
ACCESS_TOKEN_TTL=15m

# Refresh token lifetime (default 30d).
REFRESH_TOKEN_TTL=30d

# bcrypt cost factor (default 12). Each +1 doubles login/signup CPU time.
BCRYPT_ROUNDS=12

# Max page size the client may request (default 50).
MAX_PAGE_SIZE=50

# How far back the affinity feed looks for candidates, in days (default 180).
# Bounds the candidate set so "For you" cannot degrade into a full scan as the
# corpus grows. Lower it to favour freshness.
FEED_WINDOW_DAYS=180

# Keyword alias cache lifetime in seconds (default 300). Raise if keywords
# change rarely; the cache self-invalidates on keyword writes regardless.
KEYWORD_CACHE_TTL=300

# Requests per 15-minute window per IP (default 300).
RATE_LIMIT_MAX=300

# Stricter limit for signup/login/refresh, per 15-minute window (default 20).
AUTH_RATE_LIMIT_MAX=20

# pino level: trace|debug|info|warn|error|fatal (default info; silent in test)
LOG_LEVEL=info
